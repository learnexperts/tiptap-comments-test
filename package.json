{
  "name": "comments",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --project=repro --tags-filter='!writeback'",
    "test:utils": "vitest run --project=utils",
    "test:workaround": "vitest run --project=workaround",
    "test:probes": "vitest run --project=repro --tags-filter=writeback",
    "test:all": "vitest run",
    "test:watch": "vitest --project=repro --tags-filter='!writeback'",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@hocuspocus/provider": "^4.6.0",
    "@tiptap-pro/extension-comments": "^3.9.5",
    "@tiptap-pro/provider": "^3.9.5",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-collaboration": "^3.30.3",
    "@tiptap/extension-text-style": "^3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/ui": "4.1.11",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "vitest": "^4.1.11",
    "ws": "^8.21.3",
    "yjs": "13.6.32"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
